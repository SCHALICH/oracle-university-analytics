FROM docker.io/library/nginx:1.28-alpine

LABEL org.opencontainers.image.source="https://github.com/SCHALICH/oracle-university-analytics" \
      org.opencontainers.image.description="Oracle University Analytics Nginx gateway"

COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/nginx-health

USER 101:101
